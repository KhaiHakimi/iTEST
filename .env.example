# Copy to .env and adjust. Never commit .env.

# Local Ollama only. The agent refuses non-localhost addresses so no data leaves this computer.
AGENT_OLLAMA_URL=http://127.0.0.1:11434

# Text model for the AI brain (Phase 2). Without a dedicated GPU, start with qwen3:4b.
AGENT_OLLAMA_MODEL=qwen3:8b

# The start-up check warns if a test prompt takes longer than this (seconds).
AGENT_OLLAMA_WARN_SECONDS=10
