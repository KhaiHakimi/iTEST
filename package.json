{
  "name": "ai-testing-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Local AI testing agent for in-house web applications (YTL Cement Group IT).",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "agent": "tsx src/cli.ts",
    "ui": "tsx src/cli.ts ui",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/cli.js",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "gts lint",
    "fix": "gts fix",
    "test": "vitest run",
    "browsers": "playwright install chromium",
    "demo-app": "node examples/demo-app/server.mjs"
  },
  "dependencies": {
    "@axe-core/playwright": "4.14.0",
    "@fontsource/pixelify-sans": "5.3.0",
    "@fontsource/press-start-2p": "5.3.0",
    "@fontsource/vt323": "5.3.0",
    "playwright": "1.65.0",
    "playwright-core": "1.65.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "globals": "16.5.0",
    "gts": "7.0.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
